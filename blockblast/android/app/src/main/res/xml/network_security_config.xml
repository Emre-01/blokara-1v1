<?xml version="1.0" encoding="utf-8"?>
<!-- Yayın derlemesi: tüm ağ trafiği HTTPS/WSS olmalıdır. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
